# Procedural 3D Spatial Plasma Shader
# Authored in CrShader Crystal DSL for Godot 4
shader_type :spatial

render_mode :cull_disabled, :depth_draw_opaque

setup_gdshader

uniform plasma_speed : Float32 = 1.5, hint: hint_range(0.1, 5.0)
uniform plasma_scale : Float32 = 3.0, hint: hint_range(0.5, 10.0)
uniform plasma_color_a : Color = Color.new(0.9, 0.2, 0.5, 1.0), hint: :source_color
uniform plasma_color_b : Color = Color.new(0.1, 0.7, 0.9, 1.0), hint: :source_color
uniform roughness_val : Float32 = 0.25, hint: hint_range(0.0, 1.0)
uniform metallic_val : Float32 = 0.6, hint: hint_range(0.0, 1.0)

varying v_world_pos : Vec3

def vertex
  v_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz
  pulse = sin(TIME * plasma_speed + VERTEX.y * plasma_scale) * 0.05
  VERTEX = VERTEX + (NORMAL * pulse)
end

def fragment
  p = v_world_pos * plasma_scale
  v1 = sin(p.x + TIME * plasma_speed)
  v2 = sin(p.y + TIME * plasma_speed * 1.3)
  v3 = sin((p.x + p.y + p.z) * 0.5 + TIME * plasma_speed * 0.8)
  plasma = (v1 + v2 + v3) / 3.0
  factor = clamp(plasma * 0.5 + 0.5, 0.0, 1.0)

  col = mix(plasma_color_a.rgb, plasma_color_b.rgb, factor)

  ALBEDO = col
  ROUGHNESS = roughness_val
  METALLIC = metallic_val
  EMISSION = col * (factor * 0.4)
end
