; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LibGodot Test Suite"
run/main_scene="res://scenes/main_test_runner.tscn"
config/features=PackedStringArray("4.8")
config/icon="res://icon.svg"

[editor_plugins]

enabled=PackedStringArray("res://addons/crystal_integration/plugin.cfg", "res://addons/dummy_audio/plugin.cfg", "res://addons/dummy_dialogue/plugin.cfg", "res://addons/dummy_inventory/plugin.cfg", "res://addons/test_runner/plugin.cfg")

[rendering]

textures/vram_compression/import_etc2_astc=true
