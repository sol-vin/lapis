godot.exe
/.godot/
/bin/*
!/bin/.gitkeep
/addons/*/bin/

/examples/*/.godot/
/examples/*/bin/
/examples/*/addons/
/examples/*/*.exe

/template/.godot/
/template/bin/*
!/template/bin/.gitkeep
/template/addons/
/template/scripts/
/template/src/generated/
/template/*.exe

/template-addon/.godot/
/template-addon/bin/
/template-addon/scripts/
/template-addon/addons/*/bin/
/template-addon/addons/crystal_integration/
/template-addon/src/generated/
/template-addon/dist/

/examples/*/.godot/
/examples/*/bin/
/examples/*/addons/
/examples/*/scripts/dump_project_nodes.gd*
/examples/*/scripts/generate_project_bindings.cr*
/examples/*/src/generated/
/examples/*/*.exe
/examples/*/*.log

/test/.godot/
/test/bin/*
!/test/bin/.gitkeep
/test/*.exe
/test/tests
/test/addons/*/bin/
/test/addons/crystal_integration/
/test/scripts/dump_project_nodes.gd*
/test/scripts/generate_project_bindings.cr*

/performance/.godot/
/performance/bin/
/performance/scripts/
/performance/src/generated/
/performance/*.exe
/performance/perf
/performance/addons/*/bin/
/performance/addons/crystal_integration/

/benchmarks/bin
/benchmarks/.godot
/benchmarks/results

/tools/lapis/bin

/docs/
/scratch/
*.obj
.*_tests_*
.*_test_results*
dist/
*.zip
*.log
*.dll
*.so
*.dylib
*.pdb
*.exp
*.lib
*.o
cc_wrapper.sh
**/cc_wrapper.sh

test_report.*
junit*.xml
**/junit*.xml
android_audit_report.txt
godot-src/

# Crystal dependency artifacts
lib/
shard.lock

# Android keystore & release secrets
/android/
*.keystore
*.jks
*.credentials.json
*credentials*.json
*.uid

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Consumer godot-version.yml (synchronized from repository root or generated)
/test/godot-version.yml
/template/godot-version.yml
/template-addon/godot-version.yml
/performance/godot-version.yml
/examples/*/godot-version.yml
