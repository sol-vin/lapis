{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lapis: Build Game (F5)",
      "type": "shell",
      "command": "${workspaceFolder}/bin/lapis.exe build game",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Lapis: Run Game",
      "type": "shell",
      "command": "${workspaceFolder}/bin/lapis.exe run",
      "problemMatcher": []
    },
    {
      "label": "Lapis: Run Tests",
      "type": "shell",
      "command": "${workspaceFolder}/bin/lapis.exe test",
      "problemMatcher": []
    },
    {
      "label": "Lapis: Doctor Diagnostics",
      "type": "shell",
      "command": "${workspaceFolder}/bin/lapis.exe doctor",
      "problemMatcher": []
    }
  ]
}
