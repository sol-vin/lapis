#!/bin/sh
# =============================================================================
# Lapis Engine Workspace - Git Pre-Commit Hook (Managed by Carbon)
# =============================================================================

# Skip if explicitly bypassed
if [ "$SKIP_VERSION_BUMP" = "1" ] || [ "$NO_BUMP" = "1" ]; then
  exit 0
fi

# Skip during active merges
if [ -f .git/MERGE_HEAD ]; then
  exit 0
fi

# 1. Detect Godot version upgrade relative to master and auto-bump Lapis minor version (0.X.0)
if [ -f "godot-version.yml" ] && [ -f "shard.yml" ] && git rev-parse --verify master >/dev/null 2>&1; then
  GODOT_VER=$(grep -E '^[[:space:]]*version:' "godot-version.yml" | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([^"'"'"'#[:space:]]+)["'"'"']?.*/\1/')
  MASTER_GODOT_VER=$(git show master:godot-version.yml 2>/dev/null | grep -E '^[[:space:]]*version:' | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([^"'"'"'#[:space:]]+)["'"'"']?.*/\1/')
  CURR_VER=$(grep -E '^[[:space:]]*version:' "shard.yml" | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([0-9]+\.[0-9]+\.[0-9]+)["'"'"']?.*/\1/')
  MASTER_VER=$(git show master:shard.yml 2>/dev/null | grep -E '^[[:space:]]*version:' | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([0-9]+\.[0-9]+\.[0-9]+)["'"'"']?.*/\1/')

  if [ -n "$GODOT_VER" ] && [ -n "$MASTER_GODOT_VER" ] && [ -n "$CURR_VER" ] && [ -n "$MASTER_VER" ]; then
    CURR_MAJ=$(echo "$CURR_VER" | cut -d. -f1)
    CURR_MIN=$(echo "$CURR_VER" | cut -d. -f2)
    MASTER_MAJ=$(echo "$MASTER_VER" | cut -d. -f1)
    MASTER_MIN=$(echo "$MASTER_VER" | cut -d. -f2)

    if [ "$GODOT_VER" != "$MASTER_GODOT_VER" ] && [ "$CURR_MAJ" = "$MASTER_MAJ" ] && [ "$CURR_MIN" = "$MASTER_MIN" ]; then
      CURR_MIN=$((MASTER_MIN + 1))
      RESET_VER="${MASTER_MAJ}.${CURR_MIN}.0"
      sed -i.bak -E "s/^(version:[[:space:]]*[\"']?)[0-9]+\.[0-9]+\.[0-9]+([\"']?)/\1${RESET_VER}\2/" "shard.yml"
      rm -f "shard.yml.bak"
      echo "[lapis] Godot version changed (${MASTER_GODOT_VER} -> ${GODOT_VER}); bumped Lapis minor version to ${RESET_VER}"
    fi
  fi
fi

# >>> CARBON AUTO-VERSION HOOK >>>
# Generated by Carbon. Do not edit this block manually.
if [ -f "bin/carbon" ]; then
  ./bin/carbon bump --hook
elif [ -f "bin/carbon.exe" ]; then
  ./bin/carbon.exe bump --hook
elif command -v carbon >/dev/null 2>&1; then
  carbon bump --hook
elif command -v crystal >/dev/null 2>&1; then
  if [ -f "src/carbon/cli.cr" ]; then
    crystal run src/carbon/cli.cr -- bump --hook
  elif [ -f "lib/carbon/src/carbon/cli.cr" ]; then
    crystal run lib/carbon/src/carbon/cli.cr -- bump --hook
  fi
fi
# <<< CARBON AUTO-VERSION HOOK <<<

# 2. Enforce branch-relative commit count (0.Y.X where X is commits on current milestone branch)
if [ -f "shard.yml" ] && git rev-parse --verify master >/dev/null 2>&1; then
  CURR_VER=$(grep -E '^[[:space:]]*version:' "shard.yml" | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([0-9]+\.[0-9]+\.[0-9]+)["'"'"']?.*/\1/')
  MASTER_VER=$(git show master:shard.yml 2>/dev/null | grep -E '^[[:space:]]*version:' | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([0-9]+\.[0-9]+\.[0-9]+)["'"'"']?.*/\1/')
  HEAD_VER=$(git show HEAD:shard.yml 2>/dev/null | grep -E '^[[:space:]]*version:' | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([0-9]+\.[0-9]+\.[0-9]+)["'"'"']?.*/\1/')

  if [ -n "$CURR_VER" ] && [ -n "$MASTER_VER" ]; then
    CURR_MAJ=$(echo "$CURR_VER" | cut -d. -f1)
    CURR_MIN=$(echo "$CURR_VER" | cut -d. -f2)
    MASTER_MAJ=$(echo "$MASTER_VER" | cut -d. -f1)
    MASTER_MIN=$(echo "$MASTER_VER" | cut -d. -f2)

    if [ "$CURR_MAJ" != "$MASTER_MAJ" ] || [ "$CURR_MIN" != "$MASTER_MIN" ]; then
      BRANCH_COMMITS=$(git rev-list --count master..HEAD 2>/dev/null || echo 0)
      HEAD_COMMIT_SAME_MIN=0
      if [ -n "$HEAD_VER" ]; then
        HEAD_MAJ=$(echo "$HEAD_VER" | cut -d. -f1)
        HEAD_MIN=$(echo "$HEAD_VER" | cut -d. -f2)
        HEAD_CMT=$(echo "$HEAD_VER" | cut -d. -f3)
        if [ "$HEAD_MAJ" = "$CURR_MAJ" ] && [ "$HEAD_MIN" = "$CURR_MIN" ]; then
          HEAD_COMMIT_SAME_MIN=$HEAD_CMT
        fi
      fi

      BASE_CMT=$BRANCH_COMMITS
      if [ "$HEAD_COMMIT_SAME_MIN" -gt "$BASE_CMT" ]; then
        BASE_CMT=$HEAD_COMMIT_SAME_MIN
      fi
      NEXT_CMT=$((BASE_CMT + 1))
      TARGET_VER="${CURR_MAJ}.${CURR_MIN}.${NEXT_CMT}"
      sed -i.bak -E "s/^(version:[[:space:]]*[\"']?)[0-9]+\.[0-9]+\.[0-9]+([\"']?)/\1${TARGET_VER}\2/" "shard.yml"
      rm -f "shard.yml.bak"
      git add "shard.yml"
    fi
  fi
fi

# 3. Restore LIBGODOT_TARGET_VERSION in src/bridge/godot_version.h from godot-version.yml
# (Carbon's generic *version*.h scanner otherwise overwrites it with the shard version)
if [ -f "godot-version.yml" ] && [ -f "src/bridge/godot_version.h" ]; then
  GODOT_VER=$(grep -E '^[[:space:]]*version:' "godot-version.yml" | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([^"'"'"'#[:space:]]+)["'"'"']?.*/\1/')
  if [ -n "$GODOT_VER" ]; then
    cat > "src/bridge/godot_version.h" <<EOF
// Auto-generated target Godot version for C++ GDExtension loader bridge
#pragma once

#ifndef LIBGODOT_TARGET_VERSION
#define LIBGODOT_TARGET_VERSION "${GODOT_VER}"
#endif
EOF
    git add "src/bridge/godot_version.h"
  fi
fi

# 4. Synchronize tools/lapis/shard.yml and README.md badge with root shard.yml
if [ -f "shard.yml" ]; then
  ROOT_VER=$(grep -E '^[[:space:]]*version:' "shard.yml" | head -n 1 | sed -E 's/^[[:space:]]*version:[[:space:]]*["'"'"']?([0-9]+\.[0-9]+\.[0-9]+)["'"'"']?.*/\1/')
  if [ -n "$ROOT_VER" ]; then
    if [ -f "tools/lapis/shard.yml" ]; then
      sed -i.bak -E "s/^(version:[[:space:]]*[\"']?)[0-9]+\.[0-9]+\.[0-9]+([\"']?)/\1${ROOT_VER}\2/" "tools/lapis/shard.yml"
      rm -f "tools/lapis/shard.yml.bak"
      git add "tools/lapis/shard.yml"
    fi
    if [ -f "README.md" ]; then
      sed -i.bak -E "s|(badge/Lapis-)[0-9]+\.[0-9]+\.[0-9]+(-blueviolet\.svg)|\1${ROOT_VER}\2|g" "README.md"
      rm -f "README.md.bak"
      git add "README.md"
    fi
  fi
fi
